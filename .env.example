# LinguaBot - variáveis de ambiente.
# Copie para ".env" e preencha. NUNCA faça commit do arquivo .env.

# --- Telegram (obrigatório) ---
# Token gerado no @BotFather. Sem ele o bot não inicia.
BOT_TOKEN=

# --- Banco de dados ---
# Caminho do arquivo SQLite. Padrão: ./data/linguabot.db
DATABASE_PATH=./data/linguabot.db

# --- Idioma de interface padrão (pt | en | es) ---
DEFAULT_UI_LANG=pt

# --- Nível de log (DEBUG | INFO | WARNING | ERROR) ---
LOG_LEVEL=INFO

# --- Limite de mensagens por usuário por minuto (antiflood) ---
RATE_LIMIT_PER_MINUTE=30

# =========================================================
# Motores de IA (todos OPCIONAIS - o bot funciona sem eles)
# =========================================================

# Geração de texto / conversação: none | gemini | ollama
# "none" usa respostas por regras (100% offline e gratuito).
LLM_PROVIDER=none

# Gemini (plano gratuito, exige chave e conta Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (LLM local, gratuito, precisa do Ollama instalado)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Reconhecimento de fala (voz -> texto): vosk | gemini | none
# "vosk" é local e gratuito (precisa baixar os modelos).
STT_PROVIDER=vosk
VOSK_MODELS_DIR=./models/vosk

# Síntese de voz (texto -> áudio): edge | gtts | piper
# "edge" é gratuito (sem chave) e tem vozes masculinas/femininas reais.
# "gtts" é gratuito mas NÃO permite escolher o gênero da voz.
TTS_PROVIDER=edge
PIPER_EXE=
PIPER_MODELS_DIR=./models/piper

# Diretório de assets locais (imagens curadas). Opcional.
ASSETS_DIR=./assets/images

# Servidor HTTP auxiliar de saúde (para plataformas tipo Render). true|false
HEALTH_ENABLED=false
PORT=10000

# Ativa o modo infantil (conteúdo protegido). true|false
KIDS_MODE_ENABLED=true
